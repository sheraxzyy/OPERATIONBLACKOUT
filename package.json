{
  "name": "operation-blackout",
  "private": true,
  "version": "1.0.0",
  "description": "OPERATION: BLACKOUT - a top-down tactical military shooter built with Phaser 3, TypeScript and Vite.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
